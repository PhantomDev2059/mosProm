# секреты: пароли команды
.env

# материалы организаторов: рассылка (ключ VPN в .ovpn!) и SDK ~500 МБ — не публикуем
data/
org_materials/

# окружения и кэш
.venv/
__pycache__/

# артефакты моделей: пересобираются compile/*.sh, *.py; в репозитории только метаданные *.json
models/*
!models/*.json
*.tpu
*.onnx
*.pt

# загруженные пользователем видео и тяжёлые примеры
uploads/
app/static/samples/*.mp4

# открытые датасеты (скачиваются отдельно, см. README)
datasets/
